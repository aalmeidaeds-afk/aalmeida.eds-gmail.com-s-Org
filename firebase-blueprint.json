        "perfilAcesso": { "type": "string", "enum": ["Associado", "Diretoria", "Financeiro", "Administrador", "SuperAdmin"] },
        "validadeCarteirinha": { "type": "string" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
