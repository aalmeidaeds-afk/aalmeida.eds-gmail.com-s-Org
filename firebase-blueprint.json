  "firestore": {
    "/associados/{userId}": {
      "schema": { "$ref": "#/entities/Associado" },
      "description": "Perfis dos associados do Moto Clube indexados por UID."
    },
    "/veiculos/{veiculoId}": {
      "schema": { "$ref": "#/entities/Veiculo" },
      "description": "Veiculos cadastrados pelos associados."
    },
    "/manutencoes/{manutencaoId}": {
      "schema": { "$ref": "#/entities/Manutencao" },
      "description": "Historico de manutencoes dos veiculos."
    },
    "/abastecimentos/{abastecimentoId}": {
      "schema": { "$ref": "#/entities/Abastecimento" },
      "description": "Historico de abastecimentos e consumo."
    },
    "/eventos/{eventoId}": {
      "schema": { "$ref": "#/entities/Evento" },
      "description": "Eventos e encontros do Moto Clube."
    },
    "/comunicados/{comunicadoId}": {
      "schema": { "$ref": "#/entities/Comunicado" },
      "description": "Comunicados e mural do Moto Clube."
    },
    "/mensalidades/{mensalidadeId}": {
      "schema": { "$ref": "#/entities/Mensalidade" },
      "description": "Mensalidades e cobrancas PIX dos associados."
    },
    "/parceiros_servicos/{parceiroId}": {
      "schema": { "$ref": "#/entities/ParceiroServico" },
      "description": "Parceiros do Moto Clube e servicos de estrada SOS."
    },
    "/configuracoes_clube/{configId}": {
      "schema": { "$ref": "#/entities/ConfiguracaoIdentidadeClube" },
      "description": "Configuracoes de Identidade do Clube (logo, cores, contato e PIX) aplicadas dinamicamente."
    }
  }
}
