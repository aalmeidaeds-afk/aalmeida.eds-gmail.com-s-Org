        "cidade": { "type": "string" },
        "estado": { "type": "string" },
        "cnhNumero": { "type": "string" },
        "cnhCategoria": { "type": "string" },
        "cnhEmissao": { "type": "string" },
        "cnhValidade": { "type": "string" },
        "cnhPrimeiraHab": { "type": "string" },
        "emergencia1Nome": { "type": "string" },
        "emergencia1Parentesco": { "type": "string" },
        "emergencia1Telefone": { "type": "string" },
        "emergencia1Whatsapp": { "type": "string" },
        "emergencia2Nome": { "type": "string" },
        "emergencia2Parentesco": { "type": "string" },
        "emergencia2Telefone": { "type": "string" },
