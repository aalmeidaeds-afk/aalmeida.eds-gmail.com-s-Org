    "ConfiguracaoIdentidadeClube": {
      "title": "ConfiguracaoIdentidadeClube",
      "description": "Configuracoes de Identidade do Clube (logo, cores, dados de contato e PIX) aplicadas dinamicamente em todo o aplicativo.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID da configuracao (ex: identidade_oficial)" },
        "userId": { "type": "string", "description": "UID do usuario/diretor que atualizou a identidade" },
        "nomeClube": { "type": "string", "description": "Nome de exibicao do Moto Clube" },
        "subtituloClube": { "type": "string", "description": "Subtitulo ou sigla do Moto Clube" },
        "lemaClube": { "type": "string", "description": "Lema oficial do Moto Clube" },
        "cnpjClube": { "type": "string", "description": "CNPJ oficial do Moto Clube" },
        "sedeCidadeEstado": { "type": "string", "description": "Cidade/UF da sede oficial" },
        "logoPreset": { "type": "string", "description": "Identificador do estilo de logo padrao" },
        "logoUri": { "type": "string", "description": "URI ou URL de logo customizado selecionado da galeria" },
        "corPrimariaHex": { "type": "string", "description": "Cor primaria da identidade em hexadecimal (#FF6D00)" },
        "corSecundariaHex": { "type": "string", "description": "Cor secundaria da identidade em hexadecimal (#FFB74D)" },
        "corDestaqueSosHex": { "type": "string", "description": "Cor de emergencia/destaque SOS em hexadecimal (#EF5350)" },
        "corFundoHex": { "type": "string", "description": "Cor de fundo principal em hexadecimal (#0E1013)" },
        "corSuperficieHex": { "type": "string", "description": "Cor dos cards/superficies em hexadecimal (#16191E)" },
        "presetPaleta": { "type": "string", "description": "Nome do tema pre-definido selecionado" },
        "emailContato": { "type": "string", "description": "E-mail oficial de contato" },
        "telefoneContato": { "type": "string", "description": "Telefone oficial da sede/secretaria" },
        "whatsappClube": { "type": "string", "description": "WhatsApp oficial da Diretoria" },
        "instagramClube": { "type": "string", "description": "Instagram oficial do clube" },
        "siteClube": { "type": "string", "description": "Site ou portal do clube" },
        "enderecoSede": { "type": "string", "description": "Endereco completo da sede" },
        "chavePix": { "type": "string", "description": "Chave PIX oficial para mensalidades e eventos" },
        "tipoChavePix": { "type": "string", "description": "Tipo da chave PIX (E-mail, CNPJ, Telefone, Aleatoria)" },
        "favorecidoPix": { "type": "string", "description": "Nome do recebedor/favorecido PIX" },
        "bancoPix": { "type": "string", "description": "Instituicao financeira da conta PIX" },
        "cidadePix": { "type": "string", "description": "Cidade do recebedor PIX" },
        "valorMensalidadePadrao": { "type": "number", "description": "Valor padrao da mensalidade em R$" },
        "diaVencimentoPadrao": { "type": "integer", "description": "Dia padrao de vencimento da mensalidade" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "nomeClube", "lemaClube", "corPrimariaHex", "corSecundariaHex", "chavePix", "valorMensalidadePadrao", "ativo", "createdAt", "updatedAt"]
    }
